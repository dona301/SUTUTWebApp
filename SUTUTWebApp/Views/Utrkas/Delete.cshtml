@model SUTUTWebApp.Models.Entities.Utrka
@{
    ViewData["Title"] = "Delete";
}
<h1>Izbriši utrku </h1>
<h3>Jeste li sigurni da želite obrisati stavku?</h3>

@if (!ViewData.ModelState.IsValid)
{
    <div class="text-danger mb-3">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <p>@error.ErrorMessage</p>
        }
    </div>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Naziv)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Naziv)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Datum)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Datum)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Grad)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Grad)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Drzava)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Drzava)</dd>
        <dt class="col-sm-2">Organizator</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Organizator.Ime)</dd>
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Status.Naziv)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="UtrkaId" />
        <input type="submit" value="Obriši" class="btn btn-danger" /> |
        <a asp-action="Index">Natrag na popis</a>
    </form>
</div>
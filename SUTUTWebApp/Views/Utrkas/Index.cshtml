@model IEnumerable<SUTUTWebApp.Models.Entities.Utrka>
@{
    ViewData["Title"] = "Utrke";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Utrke</h2>
        <a asp-action="Create" class="btn btn-success">Dodaj novu</a>
    </div>

    <form asp-action="Index" method="get" class="mb-3">
        <div class="input-group" style="max-width: 400px;">
            <input type="text"
                   name="searchString"
                   value="@ViewData["CurrentFilter"]"
                   class="form-control"
                   placeholder="Pretraži po nazivu, gradu, državi..." />
            <button type="submit" class="btn btn-outline-secondary">Pretraži</button>
            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
            {
                <a asp-action="Index" class="btn btn-outline-danger">Očisti</a>
            }
        </div>
    </form>

    <table class="table align-middle">
        <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Naziv)</th>
                <th>@Html.DisplayNameFor(model => model.Datum)</th>
                <th>@Html.DisplayNameFor(model => model.Grad)</th>
                <th>@Html.DisplayNameFor(model => model.Drzava)</th>
                <th>Organizator</th>
                <th>Status</th>
                <th>Kategorije</th>
                <th class="text-end">Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Naziv</td>
                    <td>@item.Datum</td>
                    <td>@item.Grad</td>
                    <td>@item.Drzava</td>
                    <td>@item.Organizator.Ime</td>
                    <td>@item.Status.Naziv</td>
                    <td>
                        @foreach (var k in item.Kategorijas)
                        {
                            @k.Naziv
                    
                            <br />
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@item.UtrkaId" class="btn btn-sm btn-primary">Uredi</a>
                        <a asp-action="Details" asp-route-id="@item.UtrkaId" class="btn btn-sm btn-info">Detalji</a>
                        <a asp-action="Delete" asp-route-id="@item.UtrkaId" class="btn btn-sm btn-danger">Izbriši</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>